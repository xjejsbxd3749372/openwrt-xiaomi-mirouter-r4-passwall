#
# Xiaomi Mi Router 4 / MT7621
# OpenWrt 19.07 / Linux 4.14
# 128 MiB NAND / 128 MiB RAM
# Lean PassWall + Xray configuration
#

# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mir4=y

CONFIG_TARGET_BOARD="ramips"
CONFIG_TARGET_SUBTARGET="mt7621"
CONFIG_TARGET_PROFILE="DEVICE_mir4"

CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n

# ---------------------------------------------------------------------------
# Root filesystem
# ---------------------------------------------------------------------------

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_JFFS2=n
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_TARGZ=n

CONFIG_TARGET_KERNEL_PARTSIZE=4
CONFIG_TARGET_ROOTFS_PARTSIZE=120

# ---------------------------------------------------------------------------
# Kernel
# ---------------------------------------------------------------------------

CONFIG_KERNEL_DEBUG_FS=n
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_KALLSYMS=n
CONFIG_KERNEL_KALLSYMS_EXTRA_PASS=n
CONFIG_KERNEL_PRINTK_TIME=n
CONFIG_KERNEL_PROFILING=n
CONFIG_KERNEL_FTRACE=n
CONFIG_KERNEL_MAGIC_SYSRQ=n
CONFIG_KERNEL_SWAP=y

CONFIG_CCACHE=y

# ---------------------------------------------------------------------------
# IPv6 completely disabled
# ---------------------------------------------------------------------------

CONFIG_IPV6=n
CONFIG_PACKAGE_6in4=n
CONFIG_PACKAGE_6rd=n
CONFIG_PACKAGE_6to4=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_kmod-ip6-tunnel=n
CONFIG_PACKAGE_kmod-ip6tables=n
CONFIG_PACKAGE_luci-proto-ipv6=n

# ---------------------------------------------------------------------------
# MT7621 / Wi-Fi
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_wpad-basic=y

# Mi Router 4 has no USB peripheral requirement.
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_usbutils=n
CONFIG_PACKAGE_block-mount=n

# ---------------------------------------------------------------------------
# NAND / U-Boot
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_uboot-envtools=y

# ---------------------------------------------------------------------------
# Network / firewall / TPROXY
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_firewall=y

CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-ipt-raw=y

CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-nat=y

# Hardware NAT deliberately disabled by runtime UCI.
CONFIG_PACKAGE_kmod-mtkhnat=n

# ---------------------------------------------------------------------------
# WAN / DHCP / PPPoE
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---------------------------------------------------------------------------
# LuCI minimal base
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y

CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

CONFIG_PACKAGE_luci-theme-material=n
CONFIG_PACKAGE_luci-theme-openwrt-2020=n

# ---------------------------------------------------------------------------
# PassWall
#
# 当前 PassWall main.
# 仅启用：
#   - iptables transparent proxy
#   - Xray
#
# Sing-box / SSR / Rust / Hysteria / NaiveProxy / ShadowTLS 等全部关闭。
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_luci-app-passwall=y

CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n

# ---------------------------------------------------------------------------
# PassWall minimum dependencies
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_unzip=y

CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_resolveip=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y

CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_lyaml=y

# Use mbedTLS rather than OpenSSL where possible.
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_libustream-openssl=n
CONFIG_PACKAGE_openssl-util=n

# ---------------------------------------------------------------------------
# ZRAM / memory pressure protection
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

CONFIG_CRYPTO_LZ4=y

# ---------------------------------------------------------------------------
# Remove unnecessary LuCI applications
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_luci-app-adbyby=n
CONFIG_PACKAGE_luci-app-adbyby-plus=n

CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_luci-app-adblock-fast=n

CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-commands=n

CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-ddns-go=n

CONFIG_PACKAGE_luci-app-minidlna=n
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_luci-app-opkg=n
CONFIG_PACKAGE_luci-app-samba=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-vpn=n
CONFIG_PACKAGE_luci-app-vssr=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-wol=n

# ---------------------------------------------------------------------------
# Remove associated heavy services
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_adbyby=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts-services=n

CONFIG_PACKAGE_collectd=n
CONFIG_PACKAGE_rsyslog=n
CONFIG_PACKAGE_syslog-ng=n
CONFIG_PACKAGE_ulogd=n
CONFIG_PACKAGE_ulogd-mod-extra=n

CONFIG_PACKAGE_samba36-server=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_minidlna=n
CONFIG_PACKAGE_transmission-daemon=n
CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_mwan3=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_sqm-scripts=n
CONFIG_PACKAGE_openvpn-openssl=n
CONFIG_PACKAGE_wireguard-tools=n

# ---------------------------------------------------------------------------
# Remove unnecessary filesystem / storage / diagnostics support
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-xfs=n
CONFIG_PACKAGE_kmod-fs-btrfs=n

CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_fdisk=n
CONFIG_PACKAGE_f2fs-tools=n
CONFIG_PACKAGE_dosfstools=n

CONFIG_PACKAGE_atactl=n
CONFIG_PACKAGE_hd-idle=n
CONFIG_PACKAGE_smartmontools=n

CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_ethtool=n
CONFIG_PACKAGE_strace=n
CONFIG_PACKAGE_lsof=n
CONFIG_PACKAGE_htop=n

# ---------------------------------------------------------------------------
# Remove other VPN / tunnel stacks not used by PassWall
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_luci-proto-wireguard=n

CONFIG_PACKAGE_kmod-ovpn=n
CONFIG_PACKAGE_openvpn-openssl=n

CONFIG_PACKAGE_relayd=n
CONFIG_PACKAGE_luci-proto-relay=n

# ---------------------------------------------------------------------------
# Explicitly disable every large PassWall core
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_hysteria=n
CONFIG_PACKAGE_naiveproxy=n
CONFIG_PACKAGE_shadow-tls=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_shadowsocks-rust-ssserver=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-server=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_haproxy=n
CONFIG_PACKAGE_v2ray-plugin=n
CONFIG_PACKAGE_xray-plugin=n
CONFIG_PACKAGE_simple-obfs-client=n

# ---------------------------------------------------------------------------
# Do not include large embedded GeoIP / GeoSite databases.
# PassWall can update runtime rules when needed.
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n
